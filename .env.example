# 复制成 .env 后填写：cp .env.example .env
#
# ⚠️⚠️ 下面所有取值都是**示例值**，请按自己的环境改。
#      提交代码前确认这个文件里没有你的真实地址 / 凭据 —— 本仓库是要公开的。
#
# docker compose 会自动读取同目录的 .env，做两件事：
#   1. 用它给 docker-compose.yml 里的 ${VAR} 插值（端口 / 静态 IP / 网络名 / frpc 根目录）
#   2. 通过 compose 的 env_file 把这些值**注入容器**
#
# ⚠️ 除了 TZ 和下面「端口与网络」那几项，其余每一项都只是**首次启动的种子值**：
#    程序跑起来之后，改动一律以 Web UI 里保存的为准，改这里对已经在跑的实例不再生效。

TZ=Asia/Shanghai

# ===========================================================================
# frpc
# ===========================================================================
# frpc 容器**不在这里配** —— 这里没有容器名，也没有「每个容器各自的配置路径」。
# 本项目是「一条隧道 : 一个 frpc 容器」，每个容器要登记的两样东西
# （配置文件路径、容器名）都在 Web UI 的「frpc 实例」页里填。
#
# 这里只配一件事：宿主机上**存放所有 frpc 配置的那个根目录**。
#
# ⚠️ 不必给每个 frpc 容器单独挂一行 volumes。挂一个公共根目录就够 ——
#    容器内看到的是 /frpc/<子目录>/frpc.toml。
#
# 例：宿主机 /srv/frpc/ 下面是
#         nas/frpc.toml   web/frpc.toml   game/frpc.toml
#     那么「frpc 实例」页里填的配置文件路径就是
#         /frpc/nas/frpc.toml
#         /frpc/web/frpc.toml
#         /frpc/game/frpc.toml
#
# ⚠️ 填的是**容器内**路径（/frpc/...），不是宿主路径（/srv/frpc/...）。
#    填宿主路径时页面上 config_exists 会是 false，而「自动发现绑定」遇到读不出来
#    的配置是**静默跳过**的 —— 你只会看到「全都匹配不上」，看不出是路径填错了。
FRPC_PATH=/srv/frpc

# ===========================================================================
# 端口与网络
# ===========================================================================
# 宿主机上暴露 Web UI 的端口（容器内固定 8080）
HOST_PORT=8080

# 接入一个**已存在**的 Docker 网络，并给本容器一个静态 IP。
# 用不到的话：把 docker-compose.yml 里 services 下的 networks: 和文件末尾的顶层
# networks: 两段一起删掉，这两项也就用不上了 —— 走默认 bridge 一样能跑。
#
# 静态 IP 的用途：让内网反代（Nginx / Lucky 之类）按固定地址指过来，容器重建也不变。
CONTAINER_IP=172.20.0.10
# docker network ls 里能看到的网络名。compose 只挂载它，**不会创建**。
EXTERNAL_NETWORK_NAME=docker-net

# ===========================================================================
# Web UI 登录
# ===========================================================================
# 这两个只是**首次启动时的种子值**：
#   * 首次启动会把密码用 PBKDF2-HMAC-SHA256 哈希后存进数据库
#   * 之后在 UI 上改过密码，这里的值就不再生效（改这里也没用）
#   * 忘了密码：删掉库里三行再重启即可重新播种
#       sqlite3 <数据目录>/guard.db \
#         "DELETE FROM settings WHERE key LIKE 'web_password%';"
#
# 两个都留空 = 用内置默认 admin / admin123（登录后会一直提示你改）。
# ⚠️ 别把真实密码写进这个文件再提交。
MG_WEB_USER=admin
MG_WEB_PASSWORD=

# ===========================================================================
# mefrp
# ===========================================================================
# mefrp.com -> 用户设置 -> 访问 Token
MEFRP_TOKEN=

# ===========================================================================
# Cloudflare（要用 DNS 自动同步才需要）
# ===========================================================================
# dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
# 权限：Zone / DNS / Edit；资源：包含你要管理的 zone
CF_API_TOKEN=

# ===========================================================================
# Gotify（隧道切换时推通知；不用就留空）
# ===========================================================================
# 形如 http://192.168.1.10:8080 或 https://gotify.example.com/
GOTIFY_URL=
# Gotify 应用的 token（在 Gotify 里新建一个 App）
GOTIFY_TOKEN=
